# ===================================================
# TuneSense Server Environment Configuration
# ===================================================

# Server Runtime Environment (development | production | test)
NODE_ENV=development
PORT=5000

# Client Application URL (Allowed CORS Origin)
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB Atlas Connection URI)
# In production, MONGODB_URI is strictly required.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tunesense?retryWrites=true&w=majority
MONGODB_DB_NAME=tunesense

# Music Provider Configuration (Jamendo REST API)
# Obtain a free client ID from Jamendo Developer Portal: https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=your_jamendo_client_id_here

# Authentication & Session Security (Stage 4)
# In production, JWT_SECRET is strictly required (min 32 characters recommended).
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d
