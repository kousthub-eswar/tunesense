{
  "name": "tunesense",
  "version": "0.1.0",
  "private": true,
  "description": "TuneSense: A Personalized, Context-Aware and Explainable Music Recommendation System Using NoSQL",
  "scripts": {
    "dev": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:both": "concurrently -n \"API,APP\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev\"",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "seed": "npm run seed:demo --prefix server",
    "seed:clean": "npm run clean:demo --prefix server",
    "verify": "npm run verify:stage14 --prefix server",
    "verify:hardening": "npm run verify:hardening --prefix server",
    "verify:vibe": "npm run verify:vibe --prefix server",
    "verify:gps": "npm run verify:gps --prefix server",
    "install:all": "npm install && npm install --prefix client && npm install --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
